NODE_ENV=development
PORT=5000
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=QuizShield <onboarding@resend.dev>

# Hosted HTTPS origin, with no /api suffix. FRONTEND_URL must include a Pages
# base path such as /QuizShield when that is the deployed frontend URL.
BACKEND_PUBLIC_URL=
AUTOMATION_WORKER_SECRET=
FASTN_WEBHOOK_URL=
FASTN_ACCESS_KEY=

# Administrator-guided Google onboarding; keep both settings server-side.
# Consent still requires verified teacher-specific installation routing.
FASTN_PLATFORM_API_KEY=
FASTN_GOOGLE_WIDGET_ID=

# Explicitly disabled until the hosted worker and verified Fastn flow are ready.
AUTOMATION_LIVE=false
AUTOMATION_GOOGLE_ENABLED=false
AUTOMATION_TEST_RECIPIENTS=
AUTOMATION_ALLOW_ALL_RECIPIENTS=false
